#!/bin/sh
# Run the Vitest suite before every commit.
# Tests live in web/ and must run under WSL (Node + npm are WSL-side).
echo "[pre-commit] Running tests..."
if command -v wsl >/dev/null 2>&1; then
  echo "[pre-commit] Executing tests inside WSL..."
  wsl -e bash -c "source ~/.nvm/nvm.sh && nvm use 22 && cd /mnt/f/code/sim8085-web/web && npm test -- --run" 2>&1
else
  echo "[pre-commit] WSL not found, running local shell tests..."
  cd web && npm test -- --run 2>&1
fi
status=$?
if [ $status -ne 0 ]; then
  echo "[pre-commit] Tests FAILED — commit aborted."
  exit 1
fi
echo "[pre-commit] All tests passed."
exit 0
